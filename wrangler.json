{
  "name": "mazel",
  "main": "portal/src/index.js",
  "compatibility_date": "2026-01-01",
  "build": {
    "command": "node portal/bin/deploy-guard.mjs"
  },
  "kv_namespaces": [
    {
      "binding": "MAILBOX"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTAL",
        "class_name": "Portal"
      }
    ]
  },
  "migrations": [
    {
      "tag": "do-v1",
      "new_sqlite_classes": [
        "Portal"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "vars": {
    "RELAY_URL": "https://relay.mazel-peer.workers.dev",
    "STORE": "do"
  },
  "observability": {
    "enabled": true
  }
}
